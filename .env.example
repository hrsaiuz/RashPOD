# ─── ZeptoMail ───────────────────────────────────────────────
ZEPTO_SMTP_HOST=smtp.zeptomail.com
ZEPTO_SMTP_PORT=587
ZEPTO_SMTP_FROM=rashpod.uz
ZEPTO_SMTP_USERNAME=emailapikey
ZEPTO_SMTP_PASSWORD=__SET_IN_SECRET_MANAGER__

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=__SET_IN_SECRET_MANAGER__

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rashpod

# ─── Google Cloud ────────────────────────────────────────────
GCS_BUCKET_NAME=
GCS_BUCKET_ASSETS=
GCS_BUCKET_PUBLIC=
GCS_BUCKET_PRIVATE=
GCS_PROJECT_ID=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SIGNED_URL_EXPIRES_SECONDS=900

# Leave GCS project/bucket values empty for local development. The API and worker use local storage fallbacks when NODE_ENV is not production.

# ─── Queue / Worker ──────────────────────────────────────────
QUEUE_PROVIDER=local
WORKER_SECRET=local-worker-secret

# ─── Click Payment ───────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=__SET_IN_SECRET_MANAGER__

# Printful (use Secret Manager in deployed environments)
FEATURE_GLOBAL_POD=false
PRINTFUL_ENABLED=false
PRINTFUL_API_TOKEN=__SET_IN_SECRET_MANAGER__
PRINTFUL_API_BASE_URL=https://api.printful.com
PRINTFUL_STORE_ID=
# V2 webhook secret_key is returned as hexadecimal and must remain hex here.
PRINTFUL_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# For multiple v2 webhook configurations, prefer a Secret Manager JSON object:
# {"<x-pf-webhook-public-key>":"<hex-secret-key>"}
PRINTFUL_WEBHOOK_SECRETS_JSON=

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
API_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# ─── Auth / JWT ──────────────────────────────────────────────
JWT_SECRET=__SET_IN_SECRET_MANAGER__
DESIGNER_INVITATION_TTL_HOURS=168
INTAKE_SYSTEM_OWNER_ID=
JWT_EXPIRES_IN=7d
